---
/**
 * SiteNav
 * -------
 * Minimaler fixer Header: nur die Wortmarke, die zugleich als "Home" dient
 * (zurück zur Start-View mit dem Gateway). Das frühere Fullscreen-Menü ist
 * entfallen — die Navigation zwischen den Views läuft über das Gateway auf
 * der Start-View (StartGateway.astro).
 *
 * Das View-Switching + die Deep-Links bleiben hier zentral, weil alle
 * `[data-goto]`-Elemente (Wortmarke + Gateway-Kacheln) daran hängen.
 */
import BrandMark from './BrandMark.astro';
---

<header class="site-header" data-theme="light">
  <a class="brand" href="#start" data-goto="start" aria-label="Cloudframe — zur Startansicht">
    <BrandMark class="brand__mark" />
    <span class="brand__word">Cloudframe</span>
  </a>
  <nav class="view-links" aria-label="Ansichten">
    <a href="#karte" data-goto="karte">Karte</a>
    <a href="#filme" data-goto="filme">Filme</a>
    <a href="#hardware" data-goto="hardware">Hardware</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 300;
    display: flex;
    align-items: center;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 4vw, 4rem);
    pointer-events: none; /* nur die Wortmarke fängt Klicks */
  }

  .view-links { margin-left:auto; pointer-events:auto; display:flex; gap:clamp(.6rem,2vw,1.5rem); padding:.45rem .8rem; border:1px solid currentColor; border-radius:4px; backdrop-filter:blur(16px); background:#ffffffb8; color:#111; }
  .view-links a { color:inherit; font-family:var(--font-mono); font-size:.65rem; text-decoration:none; opacity:.6; }
  .view-links a:hover,.view-links a[aria-current="page"] { opacity:1; }
  .view-links a[aria-current="page"] { text-decoration:underline; text-underline-offset:5px; }
  .site-header[data-theme="light"] .view-links { color:white; background:#11111168; border-color:#ffffff30; }
  @media(max-width:480px) { .brand__word { display:none; } .view-links { padding:.4rem .65rem; } }

  .brand {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .brand:hover {
    opacity: 0.6;
    text-decoration: none;
  }

  .brand__word {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  /* Header-Theme: hell über dunklen Views (Hero/Hardware), dunkel über weißen */
  .site-header[data-theme='light'] { color: #fff; }
  .site-header[data-theme='dark'] { color: var(--color-text); }
</style>

<script>
  const VIEWS = ['start', 'karte', 'filme', 'hardware'] as const;
  type ViewName = (typeof VIEWS)[number];

  const isView = (v: string): v is ViewName =>
    (VIEWS as readonly string[]).includes(v);

  const header = document.querySelector('.site-header') as HTMLElement;
  const gotos = Array.from(document.querySelectorAll<HTMLElement>('[data-goto]'));

  let currentView: ViewName = 'start';

  // Dunkle Views (Hero, Hardware) → heller Header; weiße Views → dunkler Header
  const DARK_VIEWS: ViewName[] = ['start', 'hardware'];
  function applyHeaderTheme() {
    header.dataset.theme = DARK_VIEWS.includes(currentView) ? 'light' : 'dark';
  }

  function setView(name: ViewName, opts: { updateHash?: boolean } = {}) {
    const { updateHash = true } = opts;
    currentView = name;

    document.querySelectorAll<HTMLElement>('.view').forEach((el) => {
      el.classList.toggle('is-active', el.dataset.view === name);
    });

    document.querySelectorAll<HTMLElement>(".view-links [data-goto]").forEach(link => {
      if (link.dataset.goto === name) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
    applyHeaderTheme();
    window.scrollTo(0, 0);
    if (updateHash) history.replaceState(null, '', `#${name}`);

    // Start: ScrollVideo neu vermessen lassen. Alle: Komponenten informieren.
    if (name === 'start') window.dispatchEvent(new Event('resize'));
    document.dispatchEvent(new CustomEvent('cloudframe:view', { detail: { view: name } }));
  }

  // Wortmarke + Gateway-Kacheln
  gotos.forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const v = el.dataset.goto;
      if (v && isView(v)) setView(v);
    });
  });

  // Deep-Link / manuelle Hash-Änderung
  const viewFromHash = (): ViewName => {
    const h = location.hash.replace('#', '');
    return isView(h) ? h : 'start';
  };
  window.addEventListener('hashchange', () =>
    setView(viewFromHash(), { updateHash: false })
  );

  setView(viewFromHash(), { updateHash: false });
</script>
