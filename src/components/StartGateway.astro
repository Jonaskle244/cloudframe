---
/**
 * StartGateway
 * ------------
 * Der Hub-Block unter dem Sölden-Hero: ein Claim-Moment plus drei
 * Preview-Kacheln, die in die anderen App-Views springen. Jede Kachel trägt
 * `data-goto` — SiteNav bindet daran automatisch seinen View-Switch, es
 * braucht also kein eigenes Navigations-JS.
 *
 * Die Preview-Medien laufen erst, wenn die Kachel im Viewport ist
 * (IntersectionObserver), und werden gestaffelt eingeblendet.
 */

import { videoUrl } from '../lib/video';

interface Gate {
  view: 'karte' | 'filme' | 'hardware';
  idx: string;
  label: string;
  blurb: string;
  media:
    | { kind: 'video'; src: string }
    | { kind: 'image'; src: string };
}

const gates: Gate[] = [
  {
    view: 'karte',
    idx: '02',
    label: 'Karte',
    blurb: '8 Orte in Deutschland & Europa — Live-Sucher mit echten Koordinaten.',
    media: { kind: 'video', src: videoUrl('oetz-talflug-1080p-crf26.mp4') },
  },
  {
    view: 'filme',
    idx: '03',
    label: 'Filme',
    blurb: 'Cinematische Querformat-Clips. Ruhige, komponierte Flüge.',
    media: { kind: 'video', src: videoUrl('prag-tower-1080p-crf26.mp4') },
  },
  {
    view: 'hardware',
    idx: '04',
    label: 'Hardware',
    blurb: 'DJI Mini 4 Pro — das Werkzeug hinter den Bildern, seziert.',
    media: { kind: 'image', src: '/hardware/drone.webp' },
  },
];
---

<section class="gateway" aria-label="Ansichten von Cloudframe">
  <div class="gateway__inner">
    <header class="gateway__intro" data-reveal>
      <p class="gateway__kicker">Ansichten</p>
      <h2 class="gateway__claim">Drei Wege<br />durch den Sucher.</h2>
      <p class="gateway__lead">
        Kein Menü nötig — steig direkt ein: die interaktive Karte, die Filme
        oder die Hardware hinter den Aufnahmen.
      </p>
    </header>

    <ul class="gateway__grid">
      {gates.map((g, i) => (
        <li class="gate" data-reveal style={`--i:${i};`}>
          <button class="gate__btn" type="button" data-goto={g.view}>
            <span class="gate__media">
              {g.media.kind === 'video' ? (
                <video
                  class="gate__video"
                  data-src={g.media.src}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                />
              ) : (
                <img
                  class="gate__img"
                  src={g.media.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="gate__scrim"></span>
              <span class="gate__frame" aria-hidden="true"></span>
            </span>

            <span class="gate__body">
              <span class="gate__idx">{g.idx}</span>
              <span class="gate__label">{g.label}</span>
              <span class="gate__blurb">{g.blurb}</span>
              <span class="gate__go" aria-hidden="true">
                Ansehen <span class="gate__arrow">→</span>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gateway {
    position: relative;
    background: #0b0b0c;
    color: #fff;
    padding: clamp(4rem, 12vh, 9rem) 0 clamp(4rem, 10vh, 7rem);
  }

  .gateway__inner {
    width: min(100% - 2.5rem, 1200px);
    margin-inline: auto;
  }

  /* ── Claim ───────────────────────────────────────────────── */
  .gateway__intro {
    max-width: 34ch;
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .gateway__kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1.1rem;
  }

  .gateway__claim {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.75rem);
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }

  .gateway__lead {
    font-size: clamp(0.9rem, 1vw + 0.5rem, 1.05rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.7);
    max-width: 46ch;
  }

  /* ── Grid ────────────────────────────────────────────────── */
  .gateway__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  @media (max-width: 820px) {
    .gateway__grid {
      grid-template-columns: 1fr;
      max-width: 30rem;
    }
  }

  .gate {
    /* Reveal-Startzustand (per JS -> .is-in) */
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s ease calc(var(--i) * 0.09s),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 0.09s);
  }

  .gateway__intro {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gateway__intro.is-in,
  .gate.is-in {
    opacity: 1;
    transform: none;
  }

  /* ── Kachel ──────────────────────────────────────────────── */
  .gate__btn {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .gate__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background: #141416;
  }

  .gate__video,
  .gate__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Hardware-Bild etwas kleiner + zentriert, damit die Drohne ganz sichtbar ist */
  .gate__img {
    object-fit: contain;
    padding: 14%;
    background:
      radial-gradient(120% 90% at 50% 40%, rgba(124, 255, 178, 0.08), transparent 70%),
      #101012;
  }

  .gate__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 11, 12, 0) 45%,
      rgba(11, 11, 12, 0.55) 100%
    );
  }

  /* Sucher-Eckwinkel, blenden beim Hover ein */
  .gate__frame {
    position: absolute;
    inset: 10px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .gate__frame::before,
  .gate__frame::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border: 1.5px solid rgba(255, 255, 255, 0.9);
  }
  .gate__frame::before {
    top: 0;
    left: 0;
    border-right: none;
    border-bottom: none;
  }
  .gate__frame::after {
    bottom: 0;
    right: 0;
    border-left: none;
    border-top: none;
  }

  .gate__btn:hover .gate__video,
  .gate__btn:hover .gate__img,
  .gate__btn:focus-visible .gate__video,
  .gate__btn:focus-visible .gate__img {
    transform: scale(1.05);
  }
  .gate__img {
    /* Bild-Kachel: Hover-Zoom dezenter, sonst clippt das contain-Padding */
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .gate__btn:hover .gate__img,
  .gate__btn:focus-visible .gate__img {
    transform: scale(1.04);
  }

  .gate__btn:hover .gate__frame,
  .gate__btn:focus-visible .gate__frame {
    opacity: 1;
  }

  .gate__btn:focus-visible .gate__media {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Kachel-Text ─────────────────────────────────────────── */
  .gate__body {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 0.7rem;
    row-gap: 0.35rem;
    padding: 1.1rem 0.15rem 0;
  }

  .gate__idx {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.45);
    grid-row: 1;
  }

  .gate__label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1.35rem, 2vw + 0.5rem, 1.75rem);
    line-height: 1;
    grid-row: 1;
  }

  .gate__blurb {
    grid-column: 2;
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }

  .gate__go {
    grid-column: 2;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gate__arrow {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gate__btn:hover .gate__arrow,
  .gate__btn:focus-visible .gate__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .gateway__intro,
    .gate {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .gate__video,
    .gate__img,
    .gate__arrow,
    .gate__frame {
      transition: none;
    }
  }
</style>

<script>
  /**
   * (1) Reveal-on-Scroll für Intro + Kacheln.
   * (2) Preview-Videos erst laden/abspielen, wenn die Kachel sichtbar ist —
   *     spart Bandbreite/GPU, solange man oben im Hero steht.
   */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initGateway() {
    const reveals = Array.from(document.querySelectorAll<HTMLElement>('.gateway [data-reveal]'));
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('.gate__video'));

    // Fallback ohne IntersectionObserver: alles sofort zeigen.
    if (!('IntersectionObserver' in window)) {
      reveals.forEach((el) => el.classList.add('is-in'));
      videos.forEach((v) => {
        if (v.dataset.src && !v.src) v.src = v.dataset.src;
      });
      return;
    }

    const revealObs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            revealObs.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 }
    );
    reveals.forEach((el) => revealObs.observe(el));

    const videoObs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (v.dataset.src && !v.src) v.src = v.dataset.src;
            if (!reduceMotion) v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.4 }
    );
    videos.forEach((v) => videoObs.observe(v));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGateway, { once: true });
  } else {
    initGateway();
  }
</script>
