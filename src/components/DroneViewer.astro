---
/**
 * DroneViewer
 * -----------
 * Inszeniertes Standbild der echten Drohne (freigestelltes Foto). Schwebt
 * mittig auf dem dunklen HUD, sanfte Idle-Hover-Animation, Kontaktschatten
 * und ein dezenter Pointer-Parallax geben Tiefe. Der Sucher-Rahmen greift
 * die Bildmarke auf. Kein Three.js mehr — das prozedurale Modell lebt nur
 * noch im Flyby-Gimmick weiter.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['drone-viewer', className]} data-drone-viewer>
  <span class="drone-viewer__glow" aria-hidden="true"></span>

  <div class="drone-viewer__scene">
    <span class="drone-viewer__shadow" aria-hidden="true"></span>
    <div class="drone-viewer__float">
      <picture>
        <source srcset="/hardware/drone.webp" type="image/webp" />
        <img
          class="drone-viewer__img"
          src="/hardware/drone.png"
          width="922"
          height="590"
          loading="lazy"
          decoding="async"
          alt="Die Cloudframe-Drohne, freigestellt auf dunklem Hintergrund"
        />
      </picture>
    </div>
  </div>

  <!-- HUD-Rahmen: greift die Sucher-Ecken der Bildmarke auf -->
  <span class="drone-viewer__bracket drone-viewer__bracket--tl" aria-hidden="true"></span>
  <span class="drone-viewer__bracket drone-viewer__bracket--tr" aria-hidden="true"></span>
  <span class="drone-viewer__bracket drone-viewer__bracket--bl" aria-hidden="true"></span>
  <span class="drone-viewer__bracket drone-viewer__bracket--br" aria-hidden="true"></span>

  <p class="drone-viewer__label">Cloudframe · Hardware</p>
  <p class="drone-viewer__hint">Bewegen für Perspektive</p>
</div>

<style>
  .drone-viewer {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(120% 90% at 50% 20%, #15151a 0%, #0b0b0e 55%, #09090b 100%);
    border: 1px solid var(--color-border, #27272a);
    border-radius: 14px;
    overflow: hidden;
    perspective: 1200px;
  }

  /* weicher Lichtkegel hinter der Drohne */
  .drone-viewer__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46% 42% at 50% 46%, rgba(122, 152, 205, 0.2), rgba(122, 152, 205, 0) 70%);
    pointer-events: none;
  }

  .drone-viewer__scene {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    transform:
      rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
      translate3d(var(--tx, 0px), var(--ty, 0px), 0);
    transition: transform 0.25s ease-out;
    will-change: transform;
  }

  .drone-viewer__float {
    display: grid;
    place-items: center;
    animation: drone-bob 7s ease-in-out infinite;
  }

  .drone-viewer__img {
    display: block;
    width: 72%;
    max-width: 560px;
    height: auto;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.45));
  }

  /* Kontaktschatten – schrumpft, wenn die Drohne „steigt" */
  .drone-viewer__shadow {
    position: absolute;
    left: 50%;
    top: 66%;
    width: 44%;
    height: 7%;
    transform: translateX(-50%);
    background:
      radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 72%);
    filter: blur(7px);
    pointer-events: none;
    animation: drone-shadow 7s ease-in-out infinite;
  }

  @keyframes drone-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-14px); }
  }

  @keyframes drone-shadow {
    0%, 100% { opacity: 0.55; transform: translateX(-50%) scale(1); }
    50%      { opacity: 0.4;  transform: translateX(-50%) scale(0.9); }
  }

  /* HUD-Eckwinkel */
  .drone-viewer__bracket {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    pointer-events: none;
  }
  .drone-viewer__bracket--tl { top: 16px; left: 16px; border-right: none; border-bottom: none; }
  .drone-viewer__bracket--tr { top: 16px; right: 16px; border-left: none; border-bottom: none; }
  .drone-viewer__bracket--bl { bottom: 16px; left: 16px; border-right: none; border-top: none; }
  .drone-viewer__bracket--br { bottom: 16px; right: 16px; border-left: none; border-top: none; }

  .drone-viewer__label {
    position: absolute;
    top: 22px;
    left: 52px;
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    pointer-events: none;
  }

  .drone-viewer__hint {
    position: absolute;
    bottom: 22px;
    right: 52px;
    font-family: var(--font-mono, monospace);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .drone-viewer__hint { display: none; }
    .drone-viewer__img { width: 82%; }
  }

  /* Bewegungsarm: kein Schweben, kein Parallax */
  @media (prefers-reduced-motion: reduce) {
    .drone-viewer__float,
    .drone-viewer__shadow { animation: none; }
    .drone-viewer__scene { transition: none; }
  }
</style>

<script>
  function initViewer(viewer: HTMLElement) {
    const scene = viewer.querySelector<HTMLElement>('.drone-viewer__scene');
    if (!scene) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let raf = 0;
    let tx = 0, ty = 0, rx = 0, ry = 0;

    function apply() {
      raf = 0;
      scene!.style.setProperty('--tx', tx.toFixed(1) + 'px');
      scene!.style.setProperty('--ty', ty.toFixed(1) + 'px');
      scene!.style.setProperty('--rx', rx.toFixed(2) + 'deg');
      scene!.style.setProperty('--ry', ry.toFixed(2) + 'deg');
    }
    function schedule() {
      if (!raf) raf = requestAnimationFrame(apply);
    }

    viewer.addEventListener('pointermove', (e) => {
      const r = viewer.getBoundingClientRect();
      const nx = (e.clientX - r.left) / r.width - 0.5;
      const ny = (e.clientY - r.top) / r.height - 0.5;
      tx = nx * 20;
      ty = ny * 14;
      ry = nx * 7;
      rx = -ny * 6;
      schedule();
    });
    viewer.addEventListener('pointerleave', () => {
      tx = ty = rx = ry = 0;
      schedule();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-drone-viewer]').forEach(initViewer);
</script>
