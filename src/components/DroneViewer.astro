---
/**
 * DroneViewer
 * -----------
 * Interaktive Three.js-Visualisierung der Drohne. Prozedural aus Geometrien
 * gebaut (kein externes Modell), PBR-Materialien + RoomEnvironment-Reflexionen,
 * OrbitControls mit Auto-Rotate. Parametrisch über CONFIG im Script unten —
 * Farben/Proportionen/Spin lassen sich dort zentral anpassen.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['drone-viewer', className]} data-drone-viewer>
  <canvas class="drone-viewer__canvas"></canvas>

  <!-- HUD-Rahmen: greift die Sucher-Ecken der Bildmarke auf -->
  <span class="drone-viewer__bracket drone-viewer__bracket--tl" aria-hidden="true"></span>
  <span class="drone-viewer__bracket drone-viewer__bracket--tr" aria-hidden="true"></span>
  <span class="drone-viewer__bracket drone-viewer__bracket--bl" aria-hidden="true"></span>
  <span class="drone-viewer__bracket drone-viewer__bracket--br" aria-hidden="true"></span>

  <p class="drone-viewer__label">Cloudframe · Hardware</p>
  <p class="drone-viewer__hint">Ziehen zum Drehen · Scrollen zum Zoomen</p>
</div>

<style>
  .drone-viewer {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background:
      radial-gradient(120% 90% at 50% 20%, #15151a 0%, #0b0b0e 55%, #09090b 100%);
    border: 1px solid var(--color-border, #27272a);
    border-radius: 14px;
    overflow: hidden;
  }

  .drone-viewer__canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }
  .drone-viewer__canvas:active { cursor: grabbing; }

  /* HUD-Eckwinkel */
  .drone-viewer__bracket {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    pointer-events: none;
  }
  .drone-viewer__bracket--tl { top: 16px; left: 16px; border-right: none; border-bottom: none; }
  .drone-viewer__bracket--tr { top: 16px; right: 16px; border-left: none; border-bottom: none; }
  .drone-viewer__bracket--bl { bottom: 16px; left: 16px; border-right: none; border-top: none; }
  .drone-viewer__bracket--br { bottom: 16px; right: 16px; border-left: none; border-top: none; }

  .drone-viewer__label {
    position: absolute;
    top: 22px;
    left: 52px;
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    pointer-events: none;
  }

  .drone-viewer__hint {
    position: absolute;
    bottom: 22px;
    right: 52px;
    font-family: var(--font-mono, monospace);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .drone-viewer__hint { display: none; }
  }
</style>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
  import { CONFIG, buildDrone } from '../lib/drone';

  function initViewer(container: HTMLElement) {
    const canvas = container.querySelector<HTMLCanvasElement>('.drone-viewer__canvas');
    if (!canvas) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;

    const scene = new THREE.Scene();

    // Realistische Reflexionen ohne externe HDRI-Datei
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 100);
    camera.position.set(2.4, 1.55, 3.0);

    // Licht
    const key = new THREE.DirectionalLight(0xffffff, 2.4);
    key.position.set(4, 6, 4);
    key.castShadow = true;
    key.shadow.mapSize.set(1024, 1024);
    key.shadow.camera.near = 1;
    key.shadow.camera.far = 20;
    key.shadow.camera.left = -4;
    key.shadow.camera.right = 4;
    key.shadow.camera.top = 4;
    key.shadow.camera.bottom = -4;
    key.shadow.bias = -0.0006;
    scene.add(key);

    const fill = new THREE.DirectionalLight(0x88aaff, 0.5);
    fill.position.set(-5, 2, -3);
    scene.add(fill);

    const rim = new THREE.DirectionalLight(0xffffff, 0.7);
    rim.position.set(0, 3, -6);
    scene.add(rim);

    // Schatten-Fänger (unsichtbarer Boden)
    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(40, 40),
      new THREE.ShadowMaterial({ opacity: 0.4 }),
    );
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -0.56;
    ground.receiveShadow = true;
    scene.add(ground);

    const { drone, propGroups } = buildDrone();
    scene.add(drone);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.minDistance = 2.4;
    controls.maxDistance = 8;
    controls.maxPolarAngle = Math.PI * 0.54;
    controls.enablePan = false;
    controls.autoRotate = !reduceMotion;
    controls.autoRotateSpeed = 0.9;
    controls.target.set(0, 0, 0);

    // Größe an Container koppeln
    function resize() {
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(container);

    // Render-Loop nur wenn sichtbar
    let last = performance.now();
    let frame = 0;
    function loop() {
      frame = requestAnimationFrame(loop);
      const now = performance.now();
      const dt = Math.min((now - last) / 1000, 0.1); // Sprung nach Pause begrenzen
      last = now;
      if (!reduceMotion) {
        for (const p of propGroups) p.rotation.y += dt * CONFIG.propSpin * p.userData.dir;
      }
      controls.update();
      renderer.render(scene, camera);
    }
    function start() {
      if (!frame) {
        last = performance.now();
        loop();
      }
    }
    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
    }

    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0.05 },
    );
    io.observe(container);
  }

  document.querySelectorAll<HTMLElement>('[data-drone-viewer]').forEach(initViewer);
</script>
