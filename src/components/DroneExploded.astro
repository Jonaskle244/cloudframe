---
const parts = [
  {name:'Gehäuse', text:'Die äußere Hülle gibt der Drohne ihre kompakte Form und schützt die innenliegenden Komponenten.', x:50, y:22},
  {name:'Antrieb', text:'Vier Motoren und ihre Propeller erzeugen Auftrieb. Unterschiedliche Drehzahlen steuern die Bewegung.', x:77, y:66},
  {name:'Kamera & Gimbal', text:'Die Kamera sitzt in einer beweglichen Aufhängung. Der 3-Achsen-Gimbal gleicht Bewegungen für ruhige Aufnahmen aus.', x:41, y:74},
];
---
<section class="explore" aria-labelledby="explore-title" data-explore data-open="false">
  <header class="explore-head">
    <div><p class="eyebrow">Ein anderer Blick aufs Fluggerät</p><h3 id="explore-title">Unter der Oberfläche.</h3></div>
    <button class="reveal-button" aria-expanded="false" aria-controls="explore-details">Aufbau entdecken <span aria-hidden="true">↗</span></button>
  </header>
  <div class="explore-layout">
    <div class="explore-stage">
      <img class="assembled" src="/hardware/drone-original-v2.jpg" width="1280" height="1280" loading="lazy" alt="DJI Mini 4 Pro im zusammengebauten Zustand" />
      <img class="exploded" src="/hardware/drone-open-end-v1.jpg" width="1280" height="720" loading="lazy" alt="Künstlerische Explosionsansicht mit angehobenem Gehäusedeckel, getrennten Propellern und Kamera-Gimbal" aria-hidden="true" />
      <video class="assembly-video" muted playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
      <span class="frame top" aria-hidden="true"></span><span class="frame bottom" aria-hidden="true"></span>
      <p class="stage-label" aria-hidden="true">DJI MINI 4 PRO <span data-stage-mode>01 / Außenansicht</span></p>
      <div class="part-pins" hidden>
        {parts.map((p,i)=><button class="part-pin" style={`left:${p.x}%;top:${p.y}%`} data-part={i} aria-label={`${p.name} erklären`} aria-pressed={i===0?'true':'false'}>{String(i+1).padStart(2,'0')}</button>)}
      </div>
    </div>
    <aside class="explore-info">
      <div class="intro-copy"><span class="big-index" aria-hidden="true">249<span>g*</span></span><h4>Klein gebaut.<br />Viel dahinter.</h4><p>Vom Antrieb bis zur stabilisierten Kamera: Entdecke die Baugruppen hinter den Aufnahmen.</p><small>* Startgewicht unter 249 g.</small></div>
      <div id="explore-details" hidden>
        <p class="eyebrow">Baugruppen entdecken</p>
        <div class="part-list" aria-label="Baugruppen">
          {parts.map((p,i)=><button data-part={i} aria-pressed={i===0?'true':'false'}><span>{String(i+1).padStart(2,'0')}</span>{p.name}<span aria-hidden="true">↗</span></button>)}
        </div>
        <div class="part-description" aria-live="polite"><h4 data-part-title>{parts[0].name}</h4><p data-part-copy>{parts[0].text}</p></div>
        <p class="concept-note">KI-Visualisierung · Aufbau schematisch dargestellt.</p>
      </div>
    </aside>
  </div>
  <p class="motion-status" role="status" aria-live="polite"></p>
  <noscript><p>Explosionsansicht: <a href="/hardware/drone-exploded-v2.webp">Bild ansehen</a></p></noscript>
</section>

<style>
  .explore { min-width:0; }
  .explore-head { display:flex; justify-content:space-between; align-items:center; gap:1.5rem; margin-bottom:1.8rem; }
  .eyebrow { font: .6rem var(--font-mono); text-transform:uppercase; letter-spacing:.18em; color:#8d9eae; margin-bottom:.85rem; }
  h3 { font-size:clamp(1.8rem,3.5vw,3.2rem); letter-spacing:-.04em; }
  button { font:inherit; cursor:pointer; }
  button:focus-visible { outline:2px solid #a5c5ff; outline-offset:5px; }
  .reveal-button { flex-shrink:0; padding:.85rem 1.2rem; border:1px solid #647891; color:#eaf1ff; background:#a3bfff12; border-radius:50px; font-size:.78rem; transition:background .2s; }
  .reveal-button:hover { background:#a3bfff26; }
  .reveal-button span { margin-left:1rem; }
  .explore-layout { display:grid; grid-template-columns:minmax(0,1fr) 260px; border:1px solid #ffffff16; border-radius:14px; overflow:hidden; background:#101215; }
  .explore-stage { position:relative; min-width:0; aspect-ratio:16/11; overflow:hidden; background:radial-gradient(ellipse at center,#202833 0%,#101215 67%); }
  .explore-stage img { position:absolute; width:100%; height:100%; object-fit:contain; transition:opacity .8s ease,transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .assembly-video { position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#101215;opacity:0;pointer-events:none;transition:opacity .2s; }
  [data-animated="true"] .exploded { transition:none;transform:none; }
  [data-playing="true"] .assembly-video { opacity:1; }
  .reveal-button:disabled { cursor:progress;opacity:.7; }
  .motion-status { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap; }
  .explore-stage .assembled { padding:0; object-fit:cover; opacity:1; transform:scale(1); }
  [data-open="false"] .stage-label, [data-open="false"] .stage-label span { color:#485361; }
  [data-open="false"] .frame { border-color:#71819880; }
  .exploded { opacity:0; transform:scale(.92); }
  [data-open="true"] .assembled { opacity:0; transform:scale(.88); }
  [data-open="true"] .exploded { opacity:1; transform:scale(1); }
  .frame { position:absolute; width:20px; height:20px; border:1px solid #9bb8df65; pointer-events:none; z-index:2; }
  .frame.top { top:1.2rem; left:1.2rem; border-right:0;border-bottom:0; }
  .frame.bottom { bottom:1.2rem;right:1.2rem;border-left:0;border-top:0; }
  .stage-label { position:absolute; top:1.4rem; left:2.9rem; right:1.4rem; display:flex; justify-content:space-between; gap:1rem; font:.52rem var(--font-mono); letter-spacing:.15em; color:#a3afbe; pointer-events:none; }
  .stage-label span { color:#738396; }
  [data-playing="true"] .stage-label, [data-playing="true"] .stage-label span { color:#a3afbe; }
  .part-pins { position:absolute; inset:0; }
  .part-pin { position:absolute; transform:translate(-50%,-50%); width:36px;height:36px;border:1px solid #c6d8ee99; border-radius:50%; background:#0f172bcc;color:#fff; font:.62rem var(--font-mono); box-shadow:0 0 0 5px #b9d4ff0c; }
  .part-pin[aria-pressed="true"] { background:#dbe9ff;color:#162334;box-shadow:0 0 0 7px #b9d4ff20; }
  .explore-info { display:flex;align-items:center;border-left:1px solid #ffffff12;padding:1.5rem; }
  .intro-copy p,.part-description p { font-size:.8rem;line-height:1.7;color:#a2acb9; }
  h4 { font-size:1.3rem;line-height:1.2;margin-bottom:.8rem; }
  .big-index { display:block;font:500 clamp(3rem,5vw,4.5rem) var(--font-sans);letter-spacing:-.06em;color:#d6e0ed;margin-bottom:1.3rem; }
  .big-index span { font:.9rem var(--font-mono);letter-spacing:0;margin-left:.4rem;color:#8190a3; }
  small { display:block;font-size:.58rem;color:#748091;margin-top:1rem; }
  .part-list { display:grid;gap:.4rem;margin-bottom:2rem; }
  .part-list button { display:flex;align-items:center;gap:.6rem;text-align:left;border:1px solid transparent;border-radius:4px;background:transparent;color:#a2acb9;padding:.65rem .55rem;font-size:.75rem; }
  .part-list button span:first-child { font:.6rem var(--font-mono);color:#8190a3; }
  .part-list button span:last-child { margin-left:auto; }
  .part-list button[aria-pressed="true"] { border-color:#a6c1e63d;background:#b8ceef0b;color:#f4f8ff; }
  .part-description { min-height:155px; }
  .concept-note { color:#7e8a9a;font-size:.58rem;line-height:1.6;margin-top:1.2rem; }
  @media(max-width:820px) { .explore-layout { grid-template-columns:1fr; } .explore-info { border-left:0;border-top:1px solid #ffffff12; } .explore-info>div { width:100%; } .intro-copy .big-index { float:right;margin:0 0 1rem 1rem; } .part-list { grid-template-columns:repeat(3,minmax(0,1fr));gap:.15rem;margin-bottom:1.5rem; } .part-list button { flex-wrap:wrap;font-size:.7rem; } .part-list button span:last-child { display:none; } .part-description { min-height:105px; } }
  @media(max-width:480px) { .explore-head { align-items:flex-start;flex-direction:column; } .explore-stage { aspect-ratio:1.25; } .explore-info { padding:1.2rem; } .stage-label { font-size:.42rem;left:2.5rem; } .part-pin { width:32px;height:32px; } }
  @media(prefers-reduced-motion:reduce) { .explore-stage img, .assembly-video { transition:none;transform:none!important; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-explore]')!;
  const toggle = root.querySelector<HTMLButtonElement>('.reveal-button')!;
  const details = root.querySelector<HTMLElement>('#explore-details')!;
  const intro = root.querySelector<HTMLElement>('.intro-copy')!;
  const pins = root.querySelector<HTMLElement>('.part-pins')!;
  const labels = ['Gehäuse','Antrieb','Kamera & Gimbal'];
  const copy = [
    'Die äußere Hülle gibt der Drohne ihre kompakte Form und schützt die innenliegenden Komponenten.',
    'Vier Motoren und ihre Propeller erzeugen Auftrieb. Unterschiedliche Drehzahlen steuern die Bewegung.',
    'Die Kamera sitzt in einer beweglichen Aufhängung. Der 3-Achsen-Gimbal gleicht Bewegungen für ruhige Aufnahmen aus.',
  ];
  const video = root.querySelector<HTMLVideoElement>('.assembly-video')!;
  const status = root.querySelector<HTMLElement>('.motion-status')!;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let targetOpen = false;
  let busy = false;
  let run = 0;
  let loadTimer: ReturnType<typeof setTimeout> | undefined;

  function settle(open: boolean) {
    run++;
    clearTimeout(loadTimer);
    busy = false;
    video.pause();
    root.dataset.playing = 'false';
    root.dataset.open = String(open);
    toggle.disabled = false;
    root.setAttribute('aria-busy', 'false');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.innerHTML = open ? 'Zusammensetzen <span aria-hidden="true">↙</span>' : 'Aufbau entdecken <span aria-hidden="true">↗</span>';
    details.hidden = !open; pins.hidden = !open; intro.hidden = open;
    root.querySelector('.assembled')!.setAttribute('aria-hidden', String(open));
    root.querySelector('.exploded')!.setAttribute('aria-hidden', String(!open));
    root.querySelector('[data-stage-mode]')!.textContent = open ? '02 / Explosionsansicht' : '01 / Außenansicht';
    status.textContent = open ? 'Explosionsansicht geöffnet. Drei Baugruppen können ausgewählt werden.' : 'Drohne zusammengesetzt.';
  }

  toggle.addEventListener('click', () => {
    if (busy) return;
    targetOpen = root.dataset.open !== 'true';
    if (reducedMotion.matches) { settle(targetOpen); return; }
    busy = true;
    const currentRun = ++run;
    toggle.disabled = true;
    toggle.textContent = targetOpen ? 'Wird geöffnet …' : 'Wird zusammengesetzt …';
    root.setAttribute('aria-busy', 'true');
    pins.hidden = true;
    status.textContent = targetOpen ? 'Die Drohne öffnet sich.' : 'Die Drohne setzt sich zusammen.';
    video.onplaying = () => {
      if (currentRun !== run) return;
      root.dataset.animated = 'true';
      root.dataset.playing = 'true';
    };
    video.onended = () => { if (currentRun === run) settle(targetOpen); };
    video.onerror = () => { if (currentRun === run) settle(targetOpen); };
    // A slow connection must not leave the control locked.
    loadTimer = setTimeout(() => { if (currentRun === run) settle(targetOpen); }, 15000);
    video.src = targetOpen ? '/hardware/drone-open-v1.mp4' : '/hardware/drone-close-v1.mp4';
    video.muted = true;
    video.play().catch(() => { if (currentRun === run) settle(targetOpen); });
  });
  document.addEventListener('cloudframe:view', (event) => {
    if ((event as CustomEvent<{view: string}>).detail?.view !== 'hardware' && busy) settle(targetOpen);
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && busy) settle(targetOpen);
  });
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches && busy) settle(targetOpen);
  });
  root.querySelectorAll<HTMLButtonElement>('[data-part]').forEach(button => {
    button.addEventListener('click', () => {
      const index = Number(button.dataset.part);
      root.querySelectorAll('[data-part]').forEach(el => el.setAttribute('aria-pressed',String((el as HTMLElement).dataset.part === String(index))));
      root.querySelector('[data-part-title]')!.textContent = labels[index];
      root.querySelector('[data-part-copy]')!.textContent = copy[index];
    });
  });
</script>
