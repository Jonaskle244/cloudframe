---
/**
 * ScrollVideo
 * -----------
 * Ein Video, dessen Wiedergabeposition (currentTime) an die Scroll-Position
 * gekoppelt ist. Das Video wird fixiert dargestellt; der äußere Section-Block
 * definiert über seine Höhe, wie lang die Scroll-Strecke ist.
 *
 * Encoding fürs Scrubbing (siehe public/videos/README.md): 1080p, 20 fps,
 * Keyframe alle 6 Bilder, keine B-Frames. All-Intra (jedes Bild Keyframe)
 * seekt zwar minimal schneller, macht die Datei aber 2–3× größer – und die
 * Dateigröße war der eigentliche Ruckel-Grund (Seeks warteten aufs Netz).
 */

interface Props {
  /** Scrub-Video für Desktop (kurzer Keyframe-Abstand, siehe Kommentar oben) */
  src: string;
  /** Optional: kleineres Loop-Video für Mobile (normaler GOP, wird nur abgespielt) */
  mobileSrc?: string;
  /** MIME-Type des Videos. Falls weggelassen, wird er anhand der Dateiendung erraten. */
  type?: string;
  /** Optional: Poster-Bild, das vor dem Laden angezeigt wird */
  poster?: string;
  /**
   * Wie viele "Bildschirmhöhen" das Video Scroll-Strecke einnehmen soll.
   * 3 = du musst 3x Viewport-Höhe scrollen, um durch das Video zu kommen.
   */
  scrollMultiplier?: number;
  /** Glättungsfaktor 0–1 (höher = direkter, niedriger = sanfter). */
  smoothing?: number;
}

const {
  src,
  mobileSrc,
  type,
  poster,
  scrollMultiplier = 3,
  smoothing = 0.12,
} = Astro.props;

/**
 * Heuristik für gängige Container.
 * Achtung: für `.mov` bewusst kein type — Chrome/Firefox filtern
 * `video/quicktime` teils als "nicht abspielbar" aus, obwohl der enthaltene
 * H.264-Stream problemlos ginge. Ohne type probiert der Browser einfach.
 */
function guessMime(path: string): string | undefined {
  const ext = path.split('.').pop()?.toLowerCase() ?? '';
  switch (ext) {
    case 'mp4':
    case 'm4v':
      return 'video/mp4';
    case 'webm':
      return 'video/webm';
    case 'ogv':
      return 'video/ogg';
    case 'mov':
    default:
      return undefined;
  }
}

const mimeType = type ?? guessMime(src);
---

<section
  class="scroll-video"
  data-src={src}
  data-mobile-src={mobileSrc ?? src}
  style={`--scroll-multiplier: ${scrollMultiplier};`}
  data-smoothing={smoothing}
>
  <div class="scroll-video__sticky">
    <video
      class="scroll-video__media"
      poster={poster}
      muted
      playsinline
      preload="none"
      disablepictureinpicture
      aria-hidden="true"
      {...(mimeType ? { 'data-type': mimeType } : {})}
    ></video>

    <div class="scroll-video__overlay">
      <slot />
    </div>
  </div>
</section>

<style>
  .scroll-video {
    position: relative;
    width: 100%;
    /* Gesamthöhe = scrollMultiplier × Viewport-Höhe. */
    height: calc(var(--scroll-multiplier, 3) * 100vh);
    background-color: #000;
  }

  .scroll-video__sticky {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .scroll-video__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* GPU-Layer erzwingen für smootheres Repainting */
    will-change: transform;
    transform: translateZ(0);
  }

  .scroll-video__overlay {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: stretch;
    pointer-events: none;
  }

  /* Wenn der User Reduced Motion bevorzugt: einfaches Standbild + Auto-Play deaktiviert */
  @media (prefers-reduced-motion: reduce) {
    .scroll-video {
      height: 100vh;
    }
  }

  /* Mobile: kein langer Scroll-Pin. Section = eine Bildschirmhöhe, das Video
     läuft als stummer Auto-Loop (Scroll-Scrubbing rendert auf iOS nicht). */
  @media (max-width: 768px) {
    .scroll-video {
      height: 100vh;
    }
  }
</style>

<script>
  /**
   * Scroll → currentTime.
   * - Desktop: Video wird komplett per fetch in den Speicher geladen (Blob), damit
   *   Seeks nie auf Range-Requests warten. Ohne CORS am Medien-Host fällt es auf
   *   die normale URL zurück.
   * - Scroll setzt nur ein Ziel; ein rAF-Loop gleitet hin (zeitbasiert) und setzt
   *   currentTime erst neu, wenn der vorige Seek gelandet ist (kein Seek-Stau).
   * - Mobile: kleines Loop-Video, kein Scrubbing (iOS rendert gescrubbte Frames nicht).
   */
  type Controller = {
    el: HTMLElement;
    video: HTMLVideoElement;
    tau: number;
    target: number;
    current: number;
    duration: number;
    ready: boolean;
    top: number;
    total: number;
  };

  const controllers: Controller[] = [];
  let rafId: number | null = null;
  let lastTimestamp = 0;

  function loadInto(video: HTMLVideoElement, url: string) {
    fetch(url)
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.blob();
      })
      .then((blob) => {
        video.src = URL.createObjectURL(blob);
      })
      .catch(() => {
        video.preload = 'auto';
        video.src = url;
      });
  }

  function init() {
    const sections = document.querySelectorAll<HTMLElement>('.scroll-video');
    sections.forEach((el) => {
      const video = el.querySelector<HTMLVideoElement>('.scroll-video__media');
      if (!video) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = window.matchMedia('(max-width: 768px)').matches;

      // Reduced Motion: Standbild — das Poster bleibt sichtbar, Video wird gar nicht geladen.
      if (prefersReduced) return;

      if (isMobile) {
        video.loop = true;
        video.muted = true;
        video.preload = 'auto';
        video.src = el.dataset.mobileSrc ?? el.dataset.src ?? '';
        const tryPlay = () => { void video.play().catch(() => {}); };
        video.addEventListener('canplay', tryPlay, { once: true });
        return;
      }

      // smoothing (0–1, Anteil pro 60-fps-Frame) → Zeitkonstante in Sekunden
      const smoothing = Math.min(0.99, Math.max(0.01, parseFloat(el.dataset.smoothing ?? '0.12')));
      const controller: Controller = {
        el,
        video,
        tau: -1 / (60 * Math.log(1 - smoothing)),
        target: 0,
        current: 0,
        duration: 0,
        ready: false,
        top: 0,
        total: 0,
      };

      video.addEventListener('loadeddata', () => {
        controller.duration = isFinite(video.duration) ? video.duration : 0;
        controller.ready = controller.duration > 0;
        measure();
        updateTargets();
        controller.current = controller.target;
        video.currentTime = controller.current;
        wake();
      }, { once: true });

      const start = () => loadInto(video, el.dataset.src ?? '');
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });

      controllers.push(controller);
    });

    if (controllers.length === 0) return;

    // Geometrie nur bei Resize/Load lesen, nicht pro Frame.
    const measure = () => {
      for (const c of controllers) {
        c.top = c.el.getBoundingClientRect().top + window.scrollY;
        c.total = c.el.offsetHeight - window.innerHeight;
      }
    };

    const updateTargets = () => {
      for (const c of controllers) {
        if (!c.ready) continue;
        const progress = c.total > 0 ? Math.min(1, Math.max(0, (window.scrollY - c.top) / c.total)) : 0;
        c.target = progress * Math.max(0, c.duration - 0.05);
      }
    };

    const loop = (timestamp: number) => {
      const dt = lastTimestamp === 0 ? 1 / 60 : Math.min((timestamp - lastTimestamp) / 1000, 0.1);
      lastTimestamp = timestamp;
      updateTargets();

      let stillAnimating = false;
      for (const c of controllers) {
        if (!c.ready) continue;
        const diff = c.target - c.current;
        if (Math.abs(diff) > 0.004) {
          c.current += diff * (1 - Math.exp(-dt / c.tau));
          stillAnimating = true;
        } else {
          c.current = c.target;
        }
        // Erst neu seeken, wenn der vorige Seek fertig ist.
        if (!c.video.seeking && Math.abs(c.video.currentTime - c.current) > 0.02) {
          c.video.currentTime = c.current;
          stillAnimating = true;
        } else if (c.video.seeking) {
          stillAnimating = true;
        }
      }
      if (stillAnimating) {
        rafId = requestAnimationFrame(loop);
      } else {
        rafId = null;
        lastTimestamp = 0;
      }
    };

    const wake = () => {
      if (rafId === null) rafId = requestAnimationFrame(loop);
    };

    window.addEventListener('scroll', wake, { passive: true });
    window.addEventListener('resize', () => { measure(); wake(); }, { passive: true });
    window.addEventListener('load', () => { measure(); wake(); });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) wake();
    });
    // Views wechseln per Klasse (display:none) → beim Zurückkommen neu vermessen.
    new MutationObserver(() => { measure(); wake(); }).observe(
      document.querySelector('.view--start') ?? document.body,
      { attributes: true, attributeFilter: ['class'] },
    );

    measure();
    wake();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
