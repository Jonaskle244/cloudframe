---
/**
 * HardwareView
 * ------------
 * Vierte App-View: das Fluggerät hinter den Aufnahmen. Interaktiver
 * 3D-Viewer plus technisches Datenblatt im HUD/Sucher-Look. Dunkles
 * Theme, passend zum DroneViewer-Hintergrund.
 */
import DroneViewer from './DroneViewer.astro';
import { droneTagline, specs } from '../data/hardware';
---

<div class="hw-view">
  <div class="hw-inner container">
    <header class="hw-header">
      <p class="hw-kicker">Cloudframe</p>
      <h2>Die Hardware</h2>
      <p class="hw-lead">{droneTagline}</p>
    </header>

    <div class="hw-layout">
      <div class="hw-stage">
        <DroneViewer />
      </div>

      <aside class="hw-specs">
        <p class="hw-specs__title">Datenblatt</p>
        <dl class="hw-specs__list">
          {specs.map((s) => (
            <div class="hw-spec">
              <dt class="hw-spec__label">{s.label}</dt>
              <dd class="hw-spec__value">{s.value}</dd>
            </div>
          ))}
        </dl>
        <p class="hw-specs__note">Mausbewegung für Perspektive</p>
      </aside>
    </div>
  </div>
</div>

<style>
  .hw-view {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(120% 80% at 50% 0%, #131318 0%, #0b0b0e 60%, #09090b 100%);
    color: #fafafa;
    padding-block: clamp(5rem, 12vh, 8rem);
  }

  .hw-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vh, 3.5rem);
    width: 100%;
  }

  /* ── Header ───────────────────────────────────────────────── */
  .hw-header {
    max-width: 46ch;
  }

  .hw-kicker {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #71717a;
    margin-bottom: 0.75rem;
  }

  .hw-header h2 {
    margin-bottom: 0.75rem;
    color: #fafafa;
  }

  .hw-lead {
    color: #a1a1aa;
    font-size: 0.95rem;
    max-width: 48ch;
  }

  /* ── Layout: Viewer + Datenblatt ──────────────────────────── */
  .hw-layout {
    display: flex;
    gap: 2rem;
    align-items: stretch;
  }

  .hw-stage {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* ── Datenblatt ───────────────────────────────────────────── */
  .hw-specs {
    flex: 0 0 260px;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem;
  }

  .hw-specs__title {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #71717a;
    margin-bottom: 1.25rem;
  }

  .hw-specs__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
  }

  .hw-spec {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .hw-spec:first-child {
    border-top: none;
  }

  .hw-spec__label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #71717a;
  }

  .hw-spec__value {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #e4e4e7;
    text-align: right;
    margin: 0;
  }

  .hw-specs__note {
    margin-top: auto;
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #52525b;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 820px) {
    .hw-layout {
      flex-direction: column;
    }

    .hw-specs {
      flex: none;
      width: 100%;
    }

    .hw-specs__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 1.5rem;
    }

    .hw-spec:nth-child(2) {
      border-top: none;
    }

    .hw-specs__note {
      display: none;
    }
  }
</style>
