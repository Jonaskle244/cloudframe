---
/**
 * HardwareView
 * ------------
 * Vierte App-View: das Fluggerät hinter den Aufnahmen. Interaktiver
 * 3D-Viewer plus technisches Datenblatt im HUD/Sucher-Look. Dunkles
 * Theme, passend zum DroneViewer-Hintergrund.
 */
import DroneExploded from './DroneExploded.astro';
import { droneTagline, specs } from '../data/hardware';
---

<div class="hw-view">
  <div class="hw-inner container">
    <header class="hw-header">
      <p class="hw-kicker">Cloudframe</p>
      <h2>Die Hardware</h2>
      <p class="hw-lead">{droneTagline}</p>
    </header>

    <DroneExploded />

      <aside class="hw-specs" data-specs>
        <p class="hw-specs__title">Datenblatt</p>
        <dl class="hw-specs__list">
          {specs.map((s, i) => (
            <div class="hw-spec" style={`transition-delay:${i * 55}ms`}>
              <dt class="hw-spec__label">{s.label}</dt>
              <dd class="hw-spec__value" data-count={s.count ? '' : undefined}>{s.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
  </div>
</div>

<style>
  .hw-view {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(120% 80% at 50% 0%, #131318 0%, #0b0b0e 60%, #09090b 100%);
    color: #fafafa;
    padding-block: clamp(5rem, 12vh, 8rem);
  }

  .hw-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vh, 3.5rem);
    width: min(100% - 2rem, 1200px);
  }

  /* ── Header ───────────────────────────────────────────────── */
  .hw-header {
    max-width: 46ch;
  }

  .hw-kicker {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #71717a;
    margin-bottom: 0.75rem;
  }

  .hw-header h2 {
    margin-bottom: 0.75rem;
    color: #fafafa;
  }

  .hw-lead {
    color: #a1a1aa;
    font-size: 0.95rem;
    max-width: 48ch;
  }

  /* ── Datenblatt ───────────────────────────────────────────── */
  .hw-specs {
    width: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem;
  }

  .hw-specs__title {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #71717a;
    margin-bottom: 1.25rem;
  }

  .hw-specs__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2rem;
    margin: 0;
  }

  .hw-spec {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .hw-specs.is-revealed .hw-spec {
    opacity: 1;
    transform: none;
  }

  .hw-spec:first-child {
    border-top: none;
  }

  .hw-spec__label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #71717a;
  }

  .hw-spec__value {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #e4e4e7;
    text-align: right;
    margin: 0;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 820px) {
    .hw-specs {
      flex: none;
      width: 100%;
    }

    .hw-specs__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 1.5rem;
    }

    .hw-spec:nth-child(2) {
      border-top: none;
    }


  }

  @media (max-width: 480px) {
    .hw-specs__list { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hw-spec {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function countUp(el: HTMLElement) {
    const text = el.textContent ?? '';
    const match = text.match(/\d+/);
    if (!match) return;
    const target = Number(match[0]);
    const prefix = text.slice(0, match.index);
    const suffix = text.slice(match.index! + match[0].length);
    const start = performance.now();
    const dur = 850;
    const tick = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = prefix + Math.round(target * eased) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  function initSpecs(panel: HTMLElement) {
    const reveal = () => {
      panel.classList.add('is-revealed');
      if (!reduce) {
        panel.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => {
          window.setTimeout(() => countUp(el), 200 + i * 90);
        });
      }
    };

    if (reduce) { reveal(); return; }

    const io = new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting) { reveal(); obs.disconnect(); }
      }
    }, { threshold: 0.3 });
    io.observe(panel);
  }

  document.querySelectorAll<HTMLElement>('[data-specs]').forEach(initSpecs);
</script>
