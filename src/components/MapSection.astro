---
// MapSection.astro — Interaktive Locations-Karte
---

<section class="map-section">
  <div class="map-inner container">

    <div class="map-header">
      <p class="map-kicker">Cloudframe</p>
      <h2>Alle Locations</h2>
      <p class="map-lead">Von den Alpen bis zur Ägäis — und immer weiter.</p>
    </div>

    <div class="map-layout">
      <div class="map-wrap" id="map-wrap">
        <svg id="location-map" role="img" aria-label="Karte mit Drohnen-Locations in Europa"></svg>
        <!-- Sucher-Eckwinkel: rahmt den Viewport wie ein Kamera-HUD -->
        <div class="map-hud" aria-hidden="true">
          <span class="hud-corner hud-tl"></span>
          <span class="hud-corner hud-tr"></span>
          <span class="hud-corner hud-br"></span>
          <span class="hud-corner hud-bl"></span>
        </div>

        <!-- Ziel-Fadenkreuz (folgt dem Cursor) + Live-Geo-OSD -->
        <div class="map-crosshair" data-crosshair aria-hidden="true">
          <span class="ch-v"></span>
          <span class="ch-h"></span>
          <span class="ch-dot"></span>
        </div>
        <div class="map-osd map-osd--tl" aria-hidden="true">
          <span class="map-rec"><i></i>REC</span>
          <span class="map-coord" data-coord>51.9467°N · 009.2394°E</span>
        </div>
        <div class="map-osd map-osd--tr" aria-hidden="true">
          <span class="map-zoom" data-zoom>ZOOM ×1.0</span>
        </div>
        <div class="map-osd map-osd--bl" aria-hidden="true">
          <span>Cloudframe · GEO</span>
        </div>

        <div class="zoom-controls">
          <button class="zoom-btn" id="zoom-in" aria-label="Reinzoomen">+</button>
          <button class="zoom-btn" id="zoom-out" aria-label="Rauszoomen">−</button>
          <button class="zoom-btn zoom-reset" id="zoom-reset" aria-label="Ansicht zurücksetzen">↺</button>
        </div>
      </div>

      <aside class="location-card">
        <div id="card-empty" class="card-empty">
          <div class="idle-hud">
            <div class="idle-reticle" aria-hidden="true">
              <span class="idle-spin"></span>
              <span class="idle-ring"></span>
              <span class="idle-cross"></span>
            </div>
            <p class="idle-status">Kein Ziel erfasst</p>
            <p class="idle-coord" data-idle-coord>--.----° · ---.----°</p>
            <span class="idle-scan" aria-hidden="true"></span>
            <p class="card-hint"><span data-loc-count>8</span> Locations · Pin wählen</p>
          </div>
        </div>

        <div id="card-filled" class="card-filled" style="display:none">
          <!-- Portrait-Media (Video oder Bild), full-bleed oben in der Karte -->
          <div id="card-media" class="card-media" style="display:none">
            <video id="card-video" class="card-media-el" muted playsinline loop style="display:none"></video>
            <img id="card-img" class="card-media-el" alt="" style="display:none" />
            <div id="card-gallery" class="card-gallery" style="display:none"></div>
          </div>

          <!-- Textinfos -->
          <div class="card-info">
            <p class="card-idx" id="card-idx">01</p>
            <h3 class="card-name" id="card-name">—</h3>
            <p class="card-region" id="card-region">—</p>
            <div class="card-badges">
              <span class="cbadge">
                <span class="cbadge-label">ALT</span>
                <span class="cbadge-value" id="card-alt">—</span>
              </span>
              <span class="cbadge" id="card-res-wrap" style="display:none">
                <span class="cbadge-label">RES</span>
                <span class="cbadge-value" id="card-res">—</span>
              </span>
            </div>
          </div>
        </div>
      </aside>
    </div>

  </div>
</section>

<script>
  import * as d3 from 'd3';
  import { feature } from 'topojson-client';
  import { locations } from '../data/locations';
  import type { Location } from '../data/locations';

  const cardVideoEl = document.getElementById('card-video') as HTMLVideoElement;
  const cardImgEl  = document.getElementById('card-img')   as HTMLImageElement;
  const cardMediaEl = document.getElementById('card-media') as HTMLElement;
  const cardResWrap = document.getElementById('card-res-wrap') as HTMLElement;
  const cardResEl   = document.getElementById('card-res')   as HTMLElement;
  const cardGalleryEl = document.getElementById('card-gallery') as HTMLElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Moderne Slideshow (Crossfade + Ken-Burns) für gallery-Locations ──
  let galleryTimer: number | undefined;
  let gallerySlides: HTMLElement[] = [];
  let galleryDots: HTMLElement[] = [];
  let galleryIdx = 0;

  function galleryStop() {
    if (galleryTimer) { clearInterval(galleryTimer); galleryTimer = undefined; }
    cardGalleryEl.innerHTML = '';
    cardGalleryEl.style.display = 'none';
    gallerySlides = [];
    galleryDots = [];
    galleryIdx = 0;
  }

  function galleryGoTo(i: number) {
    if (!gallerySlides.length) return;
    galleryIdx = (i + gallerySlides.length) % gallerySlides.length;
    gallerySlides.forEach((s, n) => s.classList.toggle('is-active', n === galleryIdx));
    galleryDots.forEach((d, n) => d.classList.toggle('is-active', n === galleryIdx));
  }

  function galleryPlay() {
    if (galleryTimer || reduceMotion || gallerySlides.length < 2) return;
    galleryTimer = window.setInterval(() => galleryGoTo(galleryIdx + 1), 3600);
  }
  function galleryRestart() {
    if (galleryTimer) { clearInterval(galleryTimer); galleryTimer = undefined; }
    galleryPlay();
  }

  function galleryShow(images: string[]) {
    galleryStop();
    const track = document.createElement('div');
    track.className = 'gallery-track';
    images.forEach((src, i) => {
      const slide = document.createElement('div');
      slide.className =
        'gallery-slide ' + (i % 2 ? 'kb-out' : 'kb-in') + (i === 0 ? ' is-active' : '');
      const img = document.createElement('img');
      img.src = src;
      img.alt = '';
      img.decoding = 'async';
      img.loading = i === 0 ? 'eager' : 'lazy';
      slide.appendChild(img);
      track.appendChild(slide);
      gallerySlides.push(slide);
    });
    const dots = document.createElement('div');
    dots.className = 'gallery-dots';
    images.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'gallery-dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', `Bild ${i + 1} von ${images.length}`);
      dot.addEventListener('click', () => { galleryGoTo(i); galleryRestart(); });
      dots.appendChild(dot);
      galleryDots.push(dot);
    });
    cardGalleryEl.appendChild(track);
    cardGalleryEl.appendChild(dots);
    cardGalleryEl.style.display = 'block';
    galleryPlay();
  }

  // Auto-Advance bei Hover pausieren
  cardGalleryEl.addEventListener('pointerenter', () => {
    if (galleryTimer) { clearInterval(galleryTimer); galleryTimer = undefined; }
  });
  cardGalleryEl.addEventListener('pointerleave', () => galleryPlay());

  // ── Idle-HUD: Location-Count + scrambelnde Standby-Koordinaten ──
  const idleCoordEl = document.querySelector('[data-idle-coord]') as HTMLElement | null;
  const locCountEl  = document.querySelector('[data-loc-count]')  as HTMLElement | null;
  if (locCountEl) locCountEl.textContent = String(locations.length).padStart(2, '0');

  // Das Idle-HUD spiegelt die Live-Koordinaten unter dem Cursor (s. initMap).
  // Ohne Cursor auf der Karte bleiben die Zahlen stehen — kein Durchlaufen.

  function showCard(loc: Location) {
    const empty  = document.getElementById('card-empty')!;
    const filled = document.getElementById('card-filled')!;

    (document.getElementById('card-idx')    as HTMLElement).textContent =
      String(loc.index).padStart(2, '0');
    (document.getElementById('card-name')   as HTMLElement).textContent = loc.name;
    (document.getElementById('card-region') as HTMLElement).textContent = loc.region;
    (document.getElementById('card-alt')    as HTMLElement).textContent = loc.altitude;

    // Resolution-Badge nur bei Videos
    if (loc.resolution) {
      cardResEl.textContent    = loc.resolution;
      cardResWrap.style.display = '';
    } else {
      cardResWrap.style.display = 'none';
    }

    // Portrait-Media inline — Gallery > Video > Bild
    if (loc.gallery && loc.gallery.length) {
      cardVideoEl.pause();
      cardVideoEl.removeAttribute('src');
      cardVideoEl.style.display = 'none';
      cardImgEl.style.display   = 'none';
      galleryShow(loc.gallery);
      cardMediaEl.style.display = 'block';
    } else if (loc.portraitVideo) {
      galleryStop();
      if (cardVideoEl.getAttribute('src') !== loc.portraitVideo) {
        cardVideoEl.src = loc.portraitVideo;
        cardVideoEl.load();
      }
      cardVideoEl.style.display = 'block';
      cardImgEl.style.display   = 'none';
      cardMediaEl.style.display = 'block';
      cardVideoEl.play().catch(() => {});
    } else if (loc.portraitImage) {
      galleryStop();
      cardImgEl.src             = loc.portraitImage;
      cardImgEl.style.display   = 'block';
      cardVideoEl.pause();
      cardVideoEl.removeAttribute('src');
      cardVideoEl.style.display = 'none';
      cardMediaEl.style.display = 'block';
    } else {
      galleryStop();
      cardVideoEl.pause();
      cardVideoEl.removeAttribute('src');
      cardMediaEl.style.display = 'none';
    }

    empty.style.display  = 'none';
    filled.style.display = 'flex';

    d3.selectAll<SVGGElement, Location>('.pin-group').classed(
      'pin-active',
      (d) => d.id === loc.id
    );

  }

  async function initMap() {
    const mapWrap = document.getElementById('map-wrap')!;
    const W = mapWrap.clientWidth;
    const H = mapWrap.clientHeight;

    const svg = d3
      .select<SVGSVGElement, unknown>('#location-map')
      .attr('viewBox', `0 0 ${W} ${H}`)
      .attr('width', W)
      .attr('height', H);

    const lonSpan = 58 * (Math.PI / 180);
    const latSpanMercator = 1.147;
    const padW = W - 48;
    const padH = H - 32;
    const scale = Math.min(padW / lonSpan, padH / latSpanMercator);

    const centerLon = (-13 + 45) / 2;
    const midMercY = (Math.log(Math.tan(Math.PI / 4 + (33 * Math.PI) / 360)) +
                      Math.log(Math.tan(Math.PI / 4 + (70 * Math.PI) / 360))) / 2;
    const centerLat = (2 * Math.atan(Math.exp(midMercY)) - Math.PI / 2) * (180 / Math.PI);

    const projection = d3
      .geoMercator()
      .center([centerLon, centerLat])
      .scale(scale)
      .translate([W / 2, H / 2]);

    const path = d3.geoPath().projection(projection);

    // Zoom-Gruppe — alle Layer landen darin
    const zoomGroup = svg.append('g').attr('class', 'zoom-group');

    const world = (await d3.json('/data/countries-110m.json')) as any;
    const countries = feature(world, world.objects.countries) as any;

    // Graticule (feines Vermessungs-Gitter, liegt unter den Ländern →
    // bleibt nur über Wasser sichtbar, passt zum Sucher/HUD-Look)
    const graticule = d3.geoGraticule().step([10, 10]);
    zoomGroup
      .append('path')
      .datum(graticule as any)
      .attr('class', 'graticule')
      .attr('d', path as any);

    zoomGroup
      .append('g')
      .attr('class', 'countries-layer')
      .selectAll<SVGPathElement, unknown>('path')
      .data(countries.features)
      .join('path')
      .attr('class', 'country')
      .attr('d', path as any);

    const pinLayer = zoomGroup.append('g').attr('class', 'pins-layer');

    const pinGroups = pinLayer
      .selectAll<SVGGElement, Location>('g')
      .data(locations)
      .join('g')
      .attr('class', 'pin-group')
      .attr('transform', (d) => {
        const [x, y] = projection(d.coords)!;
        return `translate(${x},${y})`;
      })
      .style('animation-delay', (_d, i) => `${320 + i * 55}ms`)
      .style('cursor', 'pointer')
      .on('click', (_ev, d) => {
        showCard(d);
        flyTo(d);
      });

    // Sucher-Marker: pulsierender Halo, Eckrahmen (Bildmarke), Ring, Kern-Punkt
    pinGroups.append('circle').attr('class', 'pin-halo').attr('r', 9);
    pinGroups
      .append('path')
      .attr('class', 'pin-frame')
      .attr('d', 'M-9 -5V-9H-5 M5 -9H9V-5 M9 5V9H5 M-5 9H-9V5');
    pinGroups.append('circle').attr('class', 'pin-ring').attr('r', 6.5);
    pinGroups.append('circle').attr('class', 'pin-dot').attr('r', 3.5);
    pinGroups
      .append('text')
      .attr('class', 'pin-label')
      .attr('dy', 22)
      .text((d) => d.name);

    // D3 Zoom: Mausrad + Drag-Pan aktiv, Pan auf den Viewport begrenzt.
    // Die Karte lebt in einer Fullscreen-View → Wheel kollidiert nicht mit Page-Scroll.
    const zoom = d3
      .zoom<SVGSVGElement, unknown>()
      .scaleExtent([1, 9])
      .translateExtent([[0, 0], [W, H]])
      .wheelDelta((event) => -event.deltaY * 0.0016) // sanfteres Mausrad
      .on('zoom', (event) => {
        const t = event.transform;
        zoomGroup.attr('transform', t.toString());
        // Pins konstant groß halten
        pinGroups.attr('transform', (d) => {
          const [x, y] = projection(d.coords)!;
          return `translate(${x},${y}) scale(${1 / t.k})`;
        });
        if (zoomReadout) zoomReadout.textContent = `ZOOM ×${t.k.toFixed(1)}`;
      });

    const zoomReadout = document.querySelector('[data-zoom]') as HTMLElement | null;

    svg.call(zoom);

    // Live-Koordinaten unter dem Cursor (Sucher-/Recon-Look) + Ziel-Fadenkreuz
    const coordReadout = document.querySelector('[data-coord]') as HTMLElement | null;
    const crosshairEl  = document.querySelector('[data-crosshair]') as HTMLElement | null;
    const fmtCoord = (lat: number, lon: number) => {
      const ns = lat >= 0 ? 'N' : 'S';
      const ew = lon >= 0 ? 'E' : 'W';
      const la = Math.abs(lat).toFixed(4);
      const lo = Math.abs(lon).toFixed(4).padStart(7, '0');
      return `${la}°${ns} · ${lo}°${ew}`;
    };
    svg.on('pointermove', (event) => {
      const [mx, my] = d3.pointer(event);
      // Fadenkreuz an die Cursorposition (px relativ zum Karten-Viewport)
      if (crosshairEl) {
        crosshairEl.style.setProperty('--cx', `${mx}px`);
        crosshairEl.style.setProperty('--cy', `${my}px`);
      }
      mapWrap.classList.add('is-targeting');
      // tatsächliche Geo-Koordinaten (Zoom-Transform berücksichtigt)
      const t = d3.zoomTransform(svg.node() as Element);
      const geo = projection.invert?.(t.invert([mx, my]));
      if (geo) {
        const txt = fmtCoord(geo[1], geo[0]);
        if (coordReadout) coordReadout.textContent = txt;
        if (idleCoordEl)  idleCoordEl.textContent  = txt; // Idle-HUD spiegelt mit
      }
    });
    // Cursor verlässt die Karte → Fadenkreuz aus, Koordinaten frieren ein
    svg.on('pointerleave', () => {
      mapWrap.classList.remove('is-targeting');
    });

    // Intro: Länder/Graticule blenden ein, Pins poppen gestaffelt, Eckwinkel rasten ein
    if (!reduceMotion) {
      requestAnimationFrame(() => mapWrap.classList.add('is-intro'));
    }

    // Weiches Heranfahren an eine Location (zentrieren + zoomen)
    function flyTo(loc: Location) {
      const [px, py] = projection(loc.coords)!;
      const k = 3.4;
      const t = d3.zoomIdentity
        .translate(W / 2 - k * px, H / 2 - k * py)
        .scale(k);
      svg
        .transition()
        .duration(720)
        .ease(d3.easeCubicInOut)
        .call(zoom.transform, t);
    }

    // Zoom-Controls
    document.getElementById('zoom-in')!.addEventListener('click', () => {
      svg.transition().duration(280).call(zoom.scaleBy, 1.6);
    });
    document.getElementById('zoom-out')!.addEventListener('click', () => {
      svg.transition().duration(280).call(zoom.scaleBy, 1 / 1.6);
    });
    document.getElementById('zoom-reset')!.addEventListener('click', () => {
      svg.transition().duration(400).call(zoom.transform, d3.zoomIdentity);
    });
  }

  // Die Karte liegt anfangs in einem versteckten View (display:none) → clientWidth = 0.
  // Erst initialisieren, wenn der Karte-View sichtbar wird, sonst rendert das SVG 0×0.
  let mapInitialized = false;
  function tryInit() {
    if (mapInitialized) return;
    const wrap = document.getElementById('map-wrap');
    if (!wrap || wrap.clientWidth === 0) return;
    mapInitialized = true;
    initMap();
  }

  const wrapEl = document.getElementById('map-wrap');
  if (wrapEl) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((en) => en.isIntersecting)) tryInit();
    });
    io.observe(wrapEl);
  }
  document.addEventListener('cloudframe:view', (e) => {
    const view = (e as CustomEvent<{ view: string }>).detail?.view;
    if (view === 'karte') tryInit();
  });
  tryInit();
</script>

<!-- SVG-Klassen sind nicht scopebar → is:global mit Eltern-Scope -->
<style is:global>
  /* ── Card-Gallery (moderne Slideshow) ─────────────────────── */
  .location-card .card-gallery {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .location-card .gallery-track {
    position: absolute;
    inset: 0;
  }

  .location-card .gallery-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
    will-change: opacity;
  }

  .location-card .gallery-slide.is-active {
    opacity: 1;
  }

  .location-card .gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Ken-Burns: aktiver Slide zoomt langsam, Richtung wechselt pro Bild */
  .location-card .gallery-slide.is-active.kb-in img {
    animation: kb-in 6s ease-out both;
  }
  .location-card .gallery-slide.is-active.kb-out img {
    animation: kb-out 6s ease-out both;
  }
  @keyframes kb-in {
    from { transform: scale(1.12); }
    to   { transform: scale(1); }
  }
  @keyframes kb-out {
    from { transform: scale(1); }
    to   { transform: scale(1.12); }
  }

  /* untere Abdunklung → Indikatoren bleiben lesbar */
  .location-card .card-gallery::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }

  .location-card .gallery-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 2;
  }

  .location-card .gallery-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: none;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .location-card .gallery-dot.is-active {
    width: 20px;
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .location-card .gallery-slide.is-active img { animation: none; }
  }

  .map-section .graticule {
    fill: none;
    stroke: #c9d4e3;
    stroke-width: 0.5px;
    opacity: 0.4;
    pointer-events: none;
  }

  .map-section .country {
    fill: #e7e9ef;
    stroke: #f6f8fb;
    stroke-width: 0.8px;
    transition: fill 0.2s ease;
  }

  /* ── Pin: Sucher-Marker ───────────────────────────────────── */
  .map-section .pin-halo {
    fill: var(--color-accent);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .map-section .pin-frame {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6px;
    stroke-linecap: round;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.8);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .map-section .pin-ring {
    fill: #fff;
    stroke: var(--color-accent);
    stroke-width: 1.5px;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .map-section .pin-dot {
    fill: var(--color-accent);
    transition: r 0.2s ease;
  }

  .map-section .pin-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-anchor: middle;
    fill: var(--color-text-muted);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3px;
    stroke-linejoin: round;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  /* Hover */
  .map-section .pin-group:hover .pin-frame {
    opacity: 0.55;
    transform: scale(1);
  }

  .map-section .pin-group:hover .pin-label {
    opacity: 1;
  }

  .map-section .pin-group:hover .pin-dot {
    fill: #1d4ed8;
  }

  /* Aktiv */
  .map-section .pin-group.pin-active .pin-frame {
    opacity: 1;
    transform: scale(1);
  }

  .map-section .pin-group.pin-active .pin-ring {
    opacity: 1;
    stroke-width: 2px;
  }

  .map-section .pin-group.pin-active .pin-dot {
    fill: #1d4ed8;
    r: 4;
  }

  .map-section .pin-group.pin-active .pin-label {
    opacity: 1;
    fill: var(--color-text);
    font-weight: 600;
  }

  .map-section .pin-group.pin-active .pin-halo {
    animation: pinPulse 1.8s ease-out infinite;
  }

  @keyframes pinPulse {
    0%   { opacity: 0.35; transform: scale(0.6); }
    70%  { opacity: 0;    transform: scale(2.6); }
    100% { opacity: 0;    transform: scale(2.6); }
  }

  /* ── Intro beim Öffnen der Karte ──────────────────────────── */
  .map-wrap.is-intro .country {
    animation: map-layer-in 0.7s ease backwards;
  }
  .map-wrap.is-intro .graticule {
    animation: map-grat-in 0.8s ease 0.25s backwards;
  }
  .map-wrap.is-intro .pin-group {
    animation: map-layer-in 0.5s ease backwards;
    /* animation-delay wird pro Pin per JS gesetzt (gestaffeltes Poppen) */
  }
  @keyframes map-layer-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes map-grat-in {
    from { opacity: 0; }
    to   { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-section .pin-group.pin-active .pin-halo {
      animation: none;
    }
  }
</style>

<style>
  /* ── Section ──────────────────────────────────────────────── */
  .map-section {
    background: var(--color-bg);
    padding-block: 6rem;
    border-top: 1px solid var(--color-border);
  }

  .map-inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Header ───────────────────────────────────────────────── */
  .map-header {
    max-width: 42ch;
  }

