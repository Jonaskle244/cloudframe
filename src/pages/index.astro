---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import ScrollVideo from '../components/ScrollVideo.astro';
import MapSection from '../components/MapSection.astro';
import FilmsView from '../components/FilmsView.astro';
import HardwareView from '../components/HardwareView.astro';
import DroneFlyby from '../components/DroneFlyby.astro';
import StartGateway from '../components/StartGateway.astro';
import { videoUrl } from '../lib/video';
---

<Layout>
  <SiteNav />

  <main>
    <section class="view view--start is-active" data-view="start">
      <ScrollVideo src={videoUrl('soelden-berg-1080p-crf26.mp4')} scrollMultiplier={3} smoothing={0.12}>
        <div class="hero-content">
          <div class="hero-hud" aria-hidden="true">
            <span class="hud-corner hud-corner--tl"></span>
            <span class="hud-corner hud-corner--tr"></span>
            <span class="hud-corner hud-corner--bl"></span>
            <span class="hud-corner hud-corner--br"></span>
            <span class="hud-rec">
              <span class="hud-rec__dot"></span>
              <span class="hud-rec__label">REC</span>
              <span class="hud-tc" data-timecode>00:00:00</span>
            </span>
          </div>

          <div class="hero-text">
            <p class="kicker reveal" style="--d:0.05s">Cloudframe</p>
            <h1 class="reveal" style="--d:0.15s">Der Blick,<br />den kaum jemand kennt.</h1>
            <p class="lead reveal" style="--d:0.3s">
              Deutschland und Europa — aus einer Perspektive,
              die die meisten nie zu sehen kriegen.
            </p>
          </div>

          <p class="scroll-hint reveal" style="--d:0.55s" aria-hidden="true">
            <span class="scroll-hint__arrow">↓</span>
            <span class="scroll-hint__label">Scrollen</span>
          </p>

          <div class="video-meta reveal" style="--d:0.45s" aria-hidden="true">
            <span class="meta-item">
              <span class="meta-label">LOC</span>
              <span class="meta-value">Sölden, Tirol</span>
            </span>
            <span class="meta-divider"></span>
            <span class="meta-item">
              <span class="meta-label">ALT</span>
              <span class="meta-value">~3.100 m NN</span>
            </span>
            <span class="meta-divider"></span>
            <span class="meta-item">
              <span class="meta-label">RES</span>
              <span class="meta-value">4K · 30 FPS</span>
            </span>
          </div>
        </div>
      </ScrollVideo>

      <StartGateway />
    </section>

    <section class="view view--karte" data-view="karte">
      <MapSection />
    </section>

    <section class="view view--filme" data-view="filme">
      <FilmsView />
    </section>

    <section class="view view--hardware" data-view="hardware">
      <HardwareView />
    </section>
  </main>

  <DroneFlyby />
</Layout>

<style>
  main {
    display: block;
  }

  /* App-View-Switching liegt global in global.css
     (Astro entfernt diese Regeln aus dem gescopten <style>). */

  /* ── Hero ───────────────────────────────────────────────── */
  .hero-content {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'text text'
      'scroll meta';
    align-items: end;
    padding: clamp(1.5rem, 4vw, 4rem);
    padding-top: clamp(6rem, 15vh, 12rem);
    color: #fff;
  }

  .hero-text {
    grid-area: text;
    max-width: 22ch;
    text-shadow: 0 2px 32px rgba(0, 0, 0, 0.5);
    text-align: left;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.65;
    margin-bottom: 1.25rem;
  }

  .hero-text h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2rem, 4vw + 0.5rem, 4.5rem);
  }

  .lead {
    font-size: clamp(0.9rem, 1vw + 0.5rem, 1.05rem);
    line-height: 1.65;
    opacity: 0.85;
    max-width: 36ch;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.4);
    margin-inline: 0;
  }

  .scroll-hint {
    grid-area: scroll;
    align-self: end;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    opacity: 0.75;
  }

  .scroll-hint__arrow {
    font-size: 1.15rem;
    line-height: 1;
    animation: bob 2.4s ease-in-out infinite;
  }

  .scroll-hint__label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(6px); }
  }

  /* ── Intro-Reveal ───────────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    animation: heroReveal 0.75s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) forwards;
  }

  @keyframes heroReveal {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* opacity nach dem Reveal zurücknehmen, wo der Ruhezustand gedämpft ist */
  .lead.reveal { animation-name: heroRevealLead; }
  @keyframes heroRevealLead {
    to { opacity: 0.85; transform: none; }
  }
  .scroll-hint.reveal { animation-name: heroRevealHint; }
  @keyframes heroRevealHint {
    to { opacity: 0.75; transform: none; }
  }
  .kicker.reveal { animation-name: heroRevealKicker; }
  @keyframes heroRevealKicker {
    to { opacity: 0.65; transform: none; }
  }

  /* ── Sucher-/Kamera-HUD ─────────────────────────────────── */
  .hero-hud {
    position: absolute;
    inset: clamp(1rem, 2.5vw, 2rem);
    pointer-events: none;
    z-index: 1;
  }

  .hud-corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    opacity: 0;
    animation: hudLock 0.6s ease 0.15s forwards;
  }
  .hud-corner--tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .hud-corner--tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .hud-corner--bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .hud-corner--br { bottom: 0; right: 0; border-left: none; border-top: none; }

  @keyframes hudLock {
    from { opacity: 0; transform: scale(1.35); }
    to   { opacity: 1; transform: scale(1); }
  }

  .hud-rec {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0;
    animation: heroReveal 0.6s ease 0.5s forwards;
  }

  .hud-rec__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff3b30;
    box-shadow: 0 0 8px rgba(255, 59, 48, 0.8);
    animation: recBlink 1.6s steps(1) infinite;
  }

  @keyframes recBlink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0.25; }
  }

  .hud-tc { opacity: 0.7; }

  /* ── Video-Meta-Badge ───────────────────────────────────── */
  .video-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 0.5rem 0.85rem;
    align-self: flex-end;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-align: right;
  }

  .meta-label {
    opacity: 0.5;
    font-size: 0.5rem;
    letter-spacing: 0.2em;
  }

  .meta-value {
    white-space: nowrap;
    opacity: 0.95;
  }

  .meta-divider {
    width: 1px;
    height: 1.75rem;
    background: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 480px) {
    .video-meta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .hud-corner,
    .hud-rec {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .lead.reveal { opacity: 0.85; }
    .scroll-hint.reveal { opacity: 0.75; }
    .scroll-hint__arrow,
    .hud-rec__dot {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Kamera-OSD: tickender Timecode im Sucher-HUD. Rein kosmetisch, startet
   * bei 0 und zählt hoch. Pausiert bei verstecktem Tab, aus bei reduced-motion.
   */
  const tcEl = document.querySelector<HTMLElement>('[data-timecode]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (tcEl && !reduceMotion) {
    const pad = (n: number) => String(n).padStart(2, '0');
    let seconds = 0;
    let timer: number | undefined;

    const render = () => {
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;
      tcEl.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
    };

    const start = () => {
      if (timer !== undefined) return;
      timer = window.setInterval(() => {
        seconds += 1;
        render();
      }, 1000);
    };
    const stop = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    render();
    start();
    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : start();
    });
  }
</script>
